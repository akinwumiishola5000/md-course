; npt.mdp - equilibration at constant pressure and temperature (NPT)
; Brings the density to the right value while the protein is held in place.
define        = -DPOSRES     ; position restraints on protein heavy atoms
integrator    = md
dt            = 0.002        ; 2 fs
nsteps        = 25000        ; 25000 x 0.002 ps = 50 ps

; Output
nstxout-compressed = 500
nstenergy     = 500
nstlog        = 500

; Bonds
continuation  = yes          ; continuing from NVT
constraint_algorithm = lincs
constraints   = h-bonds

; Nonbonded interactions
cutoff-scheme = Verlet
nstlist       = 10
rcoulomb      = 1.0
rvdw          = 1.0
coulombtype   = PME
pme_order     = 4
fourierspacing = 0.16
DispCorr      = EnerPres

; Temperature coupling
tcoupl        = V-rescale
tc-grps       = Protein Non-Protein
tau_t         = 0.1     0.1
ref_t         = 300     300

; Pressure coupling (barostat)
pcoupl        = C-rescale    ; stochastic cell rescaling
pcoupltype    = isotropic
tau_p         = 2.0          ; time constant (ps)
ref_p         = 1.0          ; pressure (bar)
compressibility = 4.5e-5     ; water compressibility (1/bar)
refcoord_scaling = com       ; needed with position restraints

pbc           = xyz
gen_vel       = no           ; keep velocities from NVT
