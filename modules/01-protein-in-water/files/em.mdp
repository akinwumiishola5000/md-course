; em.mdp - energy minimization
; Removes bad contacts (atoms too close together) before dynamics.
define        = -DFLEXIBLE   ; flexible water during minimization
integrator    = steep        ; steepest descent
emtol         = 1000.0       ; stop when the maximum force < 1000 kJ/mol/nm
emstep        = 0.01         ; initial step size (nm)
nsteps        = 50000        ; maximum number of steps

nstlist       = 10
cutoff-scheme = Verlet
coulombtype   = PME          ; long-range electrostatics
rcoulomb      = 1.0          ; short-range electrostatic cutoff (nm)
rvdw          = 1.0          ; van der Waals cutoff (nm)
pbc           = xyz          ; periodic boundaries in x, y and z
